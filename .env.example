# [Optional] Custom Proxy Updater URL
# Overrides the default proxy updater service used to query available releases and release notes.
VITE_PROXY_UPDATER_URL=https://winsleep-proxy-updater.vercel.app

# [Optional] Vercel Deployment Protection Bypass Secret
# Required ONLY when testing in dev mode against a Vercel preview deployment protected
# by Vercel Authentication (Protection Bypass for Automation).
# Sent via 'x-vercel-protection-bypass' header in development mode.
VERCEL_AUTOMATION_BYPASS_SECRET=your_token_here

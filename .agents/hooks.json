{
  "auto-format-file": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/format-file.cjs",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "pre-completion-checks": {
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/scripts/verify-changes.cjs",
        "timeout": 600
      }
    ]
  }
}
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/format-file.cjs",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/verify-changes.cjs --claude",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
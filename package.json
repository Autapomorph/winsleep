{
  "name": "winsleep",
  "version": "1.1.2",
  "description": "Windows utility for scheduled system actions (Sleep, Hibernate, Shutdown, Restart, Lock, Sign Out)",
  "author": "Autapomorph",
  "license": "GPL-3.0-only",
  "repository": "https://github.com/Autapomorph/winsleep",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview",
    "lint": "run-s -c typecheck lint:js",
    "lint:js": "eslint",
    "lint:staged": "lint-staged --relative",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p ./tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ui:coverage": "vitest --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "^3.12.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@unhead/react": "^3.4.0",
    "consola": "^3.4.2",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "next-themes": "^0.4.6",
    "p-retry": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@redux-devtools/extension": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}

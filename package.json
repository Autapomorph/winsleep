{
  "name": "winsleep",
  "version": "1.4.2",
  "description": "Windows utility for scheduled system actions (Sleep, Hibernate, Shutdown, Restart, Lock, Sign Out)",
  "author": "Autapomorph",
  "license": "GPL-3.0-only",
  "repository": "https://github.com/Autapomorph/winsleep",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "vite preview",
    "lint": "run-s -c typecheck lint:js",
    "lint:js": "eslint",
    "lint:staged": "lint-staged --relative",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p ./tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ui:coverage": "vitest --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@unhead/react": "^3.4.3",
    "consola": "^3.4.2",
    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^18.0.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "react-virtuoso": "^4.18.21",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-checker": "^1.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
